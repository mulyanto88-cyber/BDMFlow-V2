# ── Data warehouse (server-side only) ────────────────────────────────────────
# MotherDuck read token. Never expose this to the browser.
MOTHERDUCK_TOKEN=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-side only — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paywall ──────────────────────────────────────────────────────────────────
# Off by default so Pro queries stay open. Set to "true" to enforce the paywall:
# queries marked `pro` in src/lib/query-registry.ts then return 402 unless the
# caller is on a paid plan or inside their trial window.
#
# Before switching this on:
#   1. Apply supabase/migrations/001_plan_and_trial.sql
#   2. Confirm profiles.plan / profiles.trial_ends_at are populated
ENFORCE_PRO_GATING=false

# ── Guest trial (client-side, baked at build time) ─────────────────────────
# Berapa hari tamu (tanpa akun) boleh membuka halaman Pro sebelum diarahkan
# ke /auth. Default 7. Set 0 = tamu langsung wajib daftar untuk halaman Pro.
# (Halaman gratis /dashboard, /sector, /groups selalu terbuka.)
NEXT_PUBLIC_TRIAL_DAYS=7

# ── Billing gateway (pilih SATU — server-side only) ─────────────────────────
# Xendit:
#   API key dari dashboard Xendit (Settings → API Keys).
#   XENDIT_WEBHOOK_TOKEN harus SAMA dengan Webhook Verification Token di
#   dashboard Xendit (Settings → Callbacks).
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=
# Midtrans:
#   Server key dari dashboard Midtrans (Settings → Access Keys).
#   Webhook diverifikasi via signature SHA512 — tidak perlu token terpisah.
MIDTRANS_SERVER_KEY=
#   Opsional: arahkan ke https://app.sandbox.midtrans.com untuk mode sandbox.
# MIDTRANS_API_BASE=

# ── Google Drive & Sheets (Untuk ETL Backup & Raw Data) ────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
TOKEN_SHEET_ID=

# ── Cloudflare R2 (Target Migrasi Data Lake) ───────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
